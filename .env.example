# Copy this file to .env and fill in the values from the AWS Cognito console.
# .env is in .gitignore, so your secrets never go to GitHub.

DJANGO_SECRET_KEY=change-me-to-any-long-random-string
DJANGO_DEBUG=True

COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=ap-southeast-2xxxxxxxx.auth.ap-southeast-2.amazoncognito.com

COGNITO_REDIRECT_URI=http://localhost:8000/callback/
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:8000/
